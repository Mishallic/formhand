{
  "name": "@formhand/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Formhand browser extension for Chrome, Edge and Firefox.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:all": "wxt build && wxt build -b edge && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b edge && wxt zip -b firefox",
    "lint:firefox": "wxt build -b firefox && web-ext lint --source-dir .output/firefox-mv2",
    "typecheck": "wxt prepare && tsc -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@formhand/core": "^0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.3",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
